{
  "expo": {
    "name": "Veterinaria El Dogo",
    "slug": "el-dogo-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegí una foto para la ficha del cliente o de la mascota.",
          "cameraPermission": "Permití usar la cámara para fotografiar clientes y mascotas.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-router"
    ],
    "scheme": "el-dogo"
  }
}
